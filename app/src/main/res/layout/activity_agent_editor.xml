<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/editor_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="start"
            android:maxLines="1"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <ImageButton
            android:id="@+id/editor_choose"
            style="@style/EditorAction"
            android:contentDescription="Выбрать файл"
            android:src="@android:drawable/ic_menu_agenda" />

        <ImageButton
            android:id="@+id/editor_save"
            style="@style/EditorAction"
            android:contentDescription="Сохранить"
            android:src="@android:drawable/ic_menu_save" />

        <ImageButton
            android:id="@+id/editor_revert"
            style="@style/EditorAction"
            android:contentDescription="Откатить"
            android:src="@android:drawable/ic_menu_revert" />

        <ImageButton
            android:id="@+id/editor_restart"
            style="@style/EditorAction"
            android:contentDescription="Перезапустить шлюз"
            android:src="@android:drawable/ic_popup_sync" />

    </LinearLayout>

    <TextView
        android:id="@+id/editor_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingHorizontal="12dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editor_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:imeOptions="flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:saveEnabled="false"
        android:scrollbars="vertical"
        android:textSize="14sp" />

</LinearLayout>
