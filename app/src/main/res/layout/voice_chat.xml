<?xml version="1.0" encoding="utf-8"?>
<com.ailamp.app.VoiceChatGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_chat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shell_surface"
    android:clickable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:paddingLeft="16dp">

        <TextView
            android:id="@+id/voice_chat_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <ImageButton
            android:id="@+id/voice_chat_close"
            style="@style/EditorAction"
            android:contentDescription="@string/voice_close"
            android:src="@drawable/ic_shell_close" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/voice_chat_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/voice_chat_recording"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="8dp">

                    <ScrollView
                        android:id="@+id/voice_chat_transcript_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:fillViewport="true"
                        android:paddingBottom="80dp">

                        <TextView
                            android:id="@+id/voice_chat_prompt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:padding="20dp"
                            android:textSize="26sp" />
                    </ScrollView>
                </FrameLayout>

                <com.ailamp.app.VoiceWaveView
                    android:id="@+id/voice_chat_input_wave"
                    android:layout_width="144dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:importantForAccessibility="no" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/voice_chat_autosend"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/voice_auto_send"
                    android:switchPadding="8dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/voice_chat_reply"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <ScrollView
                    android:id="@+id/voice_chat_reply_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:paddingBottom="80dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/voice_chat_avatar"
                            android:layout_width="@dimen/voice_avatar_size"
                            android:layout_height="@dimen/voice_avatar_size"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/voice_avatar_outline"
                            android:clipToOutline="true"
                            android:contentDescription="@string/voice_avatar"
                            android:scaleType="centerCrop"
                            android:src="@drawable/voice_agent_avatar" />

                        <com.ailamp.app.VoiceWaveView
                            android:id="@+id/voice_chat_output_wave"
                            android:layout_width="144dp"
                            android:layout_height="36dp"
                            android:layout_marginTop="8dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/voice_chat_answer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="20dp"
                            android:textIsSelectable="true"
                            android:textSize="20sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="76dp"
            android:padding="8dp">

            <com.ailamp.app.VoiceControlDock
                android:id="@+id/voice_chat_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|left"
                android:background="@drawable/voice_control_dock"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageButton
                    android:id="@+id/voice_chat_mic"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voice_start"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_btn_speak_now" />

                <ImageView
                    android:id="@+id/voice_chat_drag_handle"
                    android:layout_width="48dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/voice_drag"
                    android:scaleType="center"
                    android:src="@drawable/voice_dock_grip" />

                <ImageButton
                    android:id="@+id/voice_chat_send"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voice_send"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_send" />

                <ImageButton
                    android:id="@+id/voice_chat_text_mode"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voice_audio_answer"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:visibility="gone" />

            </com.ailamp.app.VoiceControlDock>
        </FrameLayout>
    </FrameLayout>

</com.ailamp.app.VoiceChatGestureLayout>
